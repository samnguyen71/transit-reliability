# Copy this file to .env and fill it in. Never commit .env (.gitignore skips it).
# logger/config.toml reads these values as ${NAME}.

# Your agency's API key, if its feeds need one.
TRANSIT_API_KEY=

# Healthchecks.io ping URLs, one check per feed (see logger/README.md).
HC_TRIP_UPDATES=
HC_VEHICLE_POSITIONS=
